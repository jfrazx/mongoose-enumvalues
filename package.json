{
  "name": "mongoose-enumvalues",
  "version": "0.0.3",
  "description": "Mongoose plugin that provides convenient access to enum values",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mongoose",
    "enum",
    "plugin",
    "values"
  ],
  "author": "Jason Franz",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrazx/mongoose-enumvalues"
  },
  "types": "index.d.ts",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
